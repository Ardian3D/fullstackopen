# Set this to a REAL MongoDB Atlas connection string before npm run dev.
# Never commit a file containing your password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/phonebook?retryWrites=true&w=majority
PORT=3001

# Optional, for exercise 3.12: password passed to mongo.js replaces {PASSWORD}
# MONGODB_URI_TEMPLATE=mongodb+srv://USERNAME:{PASSWORD}@CLUSTER.mongodb.net/phonebook?retryWrites=true&w=majority
